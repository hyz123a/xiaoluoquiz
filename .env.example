# Container image to pull on ECS. Replace the example value with your ACR image.
XIAOLUOQUIZ_IMAGE=registry.cn-hangzhou.aliyuncs.com/your-namespace/xiaoluoquiz:replace-with-a-release-tag

# Use :80 for an initial HTTP-only deployment. Set this to your DNS name for HTTPS.
DOMAIN=:80
HTTP_PORT=80
HTTPS_PORT=443

# Required by the server. Use an external PostgreSQL/RDS URL in production.
# For the optional local PostgreSQL Compose file, use the postgres host and a URL-safe password.
DATABASE_URL=postgres://app:replace-with-a-url-safe-password@postgres:5432/xiaoluoquiz

# Required on first startup; replace this before deployment.
INITIAL_PASSWORD=replace-with-a-long-random-password
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
DB_POOL_SIZE=10
SESSION_TTL_SECONDS=43200
RUST_LOG=xiaoluoquiz=info

# Set to 1 only when using compose.production.postgres.yaml.
USE_LOCAL_POSTGRES=1
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=xiaoluoquiz
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-url-safe-password

CADDY_IMAGE=caddy:2-alpine
